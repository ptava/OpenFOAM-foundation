components
{
    type            components;
    libs            ("libfieldFunctionObjects.so");
    field           UMean;
    enabled         yes;
    executeControl  writeTime;
    writeControl    writeTime;
    enabled         true;
    startTime       $../controlDict!foLfStart;
    endTime         $../controlDict!foLfEnd;
    executeControl  runTime;
    executeInterval $../controlDict!foLfDeltaT;
    writeControl    writeTime;
    executeAtStart  true;
}

